# Single public port → Node app service (Compose network).
# Map host HISAB_PORT (default 8080) → container :8080 only.
:8080 {
	encode gzip zstd
	# Calculate is async (202), but keep long timeouts for individual sync routes.
	reverse_proxy app:8787 {
		transport http {
			response_header_timeout 120s
			read_timeout 120s
			write_timeout 120s
		}
	}
}
