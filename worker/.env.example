HISAB_EMAIL=you@example.com
ECOMDRIVE_EMAIL=you@example.com
ECOMDRIVE_PASSWORD=
ECOMDRIVE_SECTION=active
HEADLESS=0

# Steadfast portal scrape (balances / Live Sheet calculate)
# STEADFAST_EMAIL=
# STEADFAST_PASSWORD=

# Steadfast Packzy API (portal.packzy.com) — no login; send both keys every request
STEADFAST_API_BASE=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Local (non-Docker) listen. Docker Compose forces HOST=0.0.0.0 and PORT=8787 inside
# the app container; the *published* host port is project-root `.env` → PORT=…
PORT=8787
HOST=127.0.0.1
# TRUST_PROXY=1
# HISAB_DATA_DIR=/data
# Must match the URL users open. Enables Secure cookies when https.
# PUBLIC_ORIGIN=http://127.0.0.1:8080
# PUBLIC_ORIGIN=https://hisab.example.com

# Firebase web app — leave empty for DEMO (localStorage only)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Required on production for shared Live Sheet + background calculate (server signs in as this user).
FIREBASE_AUTH_EMAIL=
FIREBASE_AUTH_PASSWORD=