HISAB_EMAIL=you@example.com
ECOMDRIVE_EMAIL=you@example.com
ECOMDRIVE_PASSWORD=
ECOMDRIVE_SECTION=active
HEADLESS=0

# One Node process serves UI + API. Behind Caddy/Docker, only the proxy port is public.
PORT=8787
HOST=127.0.0.1
# Docker Compose sets HOST=0.0.0.0, TRUST_PROXY=1, HISAB_DATA_DIR=/data for you.
# TRUST_PROXY=1
# HISAB_DATA_DIR=/data
# Must match the URL users open (Caddy origin). Enables Secure cookies when https.
# PUBLIC_ORIGIN=http://127.0.0.1:8080
# PUBLIC_ORIGIN=https://hisab.example.com

# Firebase web app — leave empty for DEMO (localStorage only)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Optional fixed shop user (no login screen). Else anonymous auth is used.
FIREBASE_AUTH_EMAIL=
FIREBASE_AUTH_PASSWORD=