HISAB_EMAIL=you@example.com
ECOMDRIVE_EMAIL=you@example.com
ECOMDRIVE_PASSWORD=
ECOMDRIVE_SECTION=active
HEADLESS=0

# One process serves UI + API (default http://127.0.0.1:8787). No separate :5500 needed.
# PORT=8787
# HOST=127.0.0.1
# On a VPS behind nginx, often: HOST=127.0.0.1 and proxy to this port.
# PUBLIC_ORIGIN=https://hisab.example.com

# Firebase web app — leave empty for DEMO (localStorage only)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
# Optional fixed shop user (no login screen). Else anonymous auth is used.
FIREBASE_AUTH_EMAIL=
FIREBASE_AUTH_PASSWORD=
